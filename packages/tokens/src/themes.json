  "typography": {
    "family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "scale": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 24,
      "2xl": 32
    }
  },
  "controlHeight": {
    "sm": 32,
    "md": 36,
    "lg": 40
  }
}
