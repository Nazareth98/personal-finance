  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
